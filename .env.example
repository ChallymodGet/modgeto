# Copy to .env.local and fill in. Never commit real values.
# Secrets for deployed environments live in Vercel → Settings → Environment Variables.

# Public site address (defaults to https://modgeto.vercel.app until modgeto.com is registered)
SITE_URL=

# Supabase (Phase 8–9)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Termii phone OTP (Phase 9)
TERMII_API_KEY=
TERMII_SENDER_ID=

# Cloudflare R2 file storage (Phase 10)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BUCKET=
R2_PRIVATE_BUCKET=

# Brevo transactional email (Phase 11)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=modgetdesigns@gmail.com
BREVO_SENDER_NAME=Modgeto

# Paystack platform subscriptions only — never Client Project payments (Phase 12)
PAYSTACK_SECRET_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
